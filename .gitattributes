# Keep text files consistent across Windows, macOS and Linux.
* text=auto
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve audio and MIDI test fixtures byte for byte.
*.wav binary
*.mid binary
*.midi binary
